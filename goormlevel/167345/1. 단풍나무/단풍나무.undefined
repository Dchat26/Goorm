import sys

input = sys.stdin.readline
write = sys.stdout.write

def solve():
	n = int(input().rstrip())
	nlist = [list(map(int, input().split())) for _ in range(n)]

	dh = [1, 0, 0, -1]
	dw = [0, 1, -1, 0]

	answer = 0
	while True:
		answer += 1
		
		is_TF = 0
		for i in range(n):
			for j in range(n):
				if nlist[i][j] != 0:
					is_TF = 1
					count = 0
					for k in range(4):
						row = i + dh[k]
						col = j + dw[k]
						if (row >= 0 and row < n) and (col >= 0 and col < n) and (nlist[row][col] == 0):
							count += 1

					if nlist[i][j] - count > 0:
						nlist[i][j] -= count
					else:
						nlist[i][j] = -1

		if is_TF:
			for i in range(n):
				for j in range(n):
					if nlist[i][j] == -1:
						nlist[i][j] = 0
		else:
			break

	write(str(answer - 1) + "\n")

if __name__ == "__main__":
	solve()